# Supabase — vlastní projekt Autografia, NIKDY nesdílet s Monetiem.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only, obchází RLS — nikdy v kódu dostupném prohlížeči.
SUPABASE_SERVICE_ROLE_KEY=

# Kdo smí schvalovat návrhy osobností na /nevyrizene. Clerk user ID
# (Dashboard → Users → vybraný uživatel → User ID, začíná "user_"),
# víc oddělených čárkou. Prázdné = frontu nevidí nikdo.
ADMIN_USER_IDS=

# Clerk — přihlašování. Klíče z clerk.com (Dashboard → API Keys). Clerk
# musí být zapnutý i jako Third-Party Auth provider ve Supabase dashboardu
# (Authentication → Sign In / Providers → Clerk), jinak auth.jwt() ve RLS
# politikách neuvidí přihlášeného uživatele — viz komentář na začátku
# supabase/migrations/0005_clerk_auth.sql.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/prihlaseni
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/registrace
